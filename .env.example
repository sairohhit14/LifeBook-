# ===== LifeBook backend environment =====
# Copy to .env (git-ignored) and fill in. Never commit real values.

# ---- Session security (REQUIRED in production) ----
# HMAC secret for session tokens. If unset, a random per-boot secret is used
# and every user is logged out on restart. Set a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# ---- Supabase (PRIMARY data + file store; optional but recommended) ----
# When set, both db.json collections (vault_data table) and uploads (public
# 'uploads' bucket) live in Supabase. When unset, local db.json + ./uploads
# are used (fine for local dev, NOT durable for production).
# One-time SQL setup:
#   create table if not exists vault_data (
#     db_key text primary key,
#     db_value jsonb not null
#   );
# And create a PUBLIC storage bucket named 'uploads'.
SUPABASE_URL="https://your-project-ref.supabase.co"
# service_role key — SERVER-SIDE ONLY, never expose to the client.
SUPABASE_KEY="your-service-role-key"

# ---- Firebase Admin (optional; registration identity mirror) ----
# Used to create Firebase Auth users on registration / Google sign-in.
# Without it, auth still works via local identities.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# ---- Firebase client (frontend; used for Google Sign-In popup) ----
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ---- Google Gemini (AI biography, companion, image description, video) ----
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---- Email delivery (optional; per-user config also possible in Settings) ----
# Protocol: "SMTP" or "Resend". With nothing configured, a disposable Ethereal
# test account is used and messages are NOT really delivered.
EMAIL_PROTOCOL="SMTP"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"LifeBook" <no-reply@lifebook.com>'
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"

# ---- App ----
# Public URL, used in outbound legacy-message emails.
APP_URL="http://localhost:3000"
