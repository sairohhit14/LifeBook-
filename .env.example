# ===== LifeBook backend environment =====
# Copy to .env (git-ignored) and fill in. Never commit real values.

# ---- Session security (REQUIRED in production) ----
# HMAC secret for session tokens. If unset, a random per-boot secret is used
# and every user is logged out on restart. Set a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# ---- Supabase (PRIMARY data + file store; optional but recommended) ----
# When set, both db.json collections (vault_data table) and uploads (public
# 'uploads' bucket) live in Supabase. When unset, local db.json + ./uploads
# are used (fine for local dev, NOT durable for production).
# One-time SQL setup:
#   create table if not exists vault_data (
#     db_key text primary key,
#     db_value jsonb not null
#   );
# And create a PUBLIC storage bucket named 'uploads'.
#
# Scheduled db.json snapshots (every 6h, gzipped, pruned to the newest 30)
# land in a PRIVATE storage bucket named 'db-backups' — same service key, no
# extra env vars. One-time setup:
#   insert into storage.buckets (id, name, public)
#   values ('db-backups', 'db-backups', false)
#   on conflict (id) do nothing;
# List snapshots:   npm run backup:restore
# Restore newest:   npm run backup:restore -- --latest
# Restore one:      npm run backup:restore -- --file db-<timestamp>.json.gz
SUPABASE_URL="https://your-project-ref.supabase.co"
# service_role key — SERVER-SIDE ONLY, never expose to the client.
# Powers the vault sync above AND Supabase Auth (email/password registration,
# login, password change). The server proxies auth calls to GoTrue with this
# key; the client never holds it. When unset, auth falls back to local
# db.json identities and existing accounts still work but do not migrate.
SUPABASE_KEY="your-service-role-key"

# ---- Firebase Admin (optional; registration identity mirror) ----
# Used to create Firebase Auth users on registration / Google sign-in.
# Without it, auth still works via local identities.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# ---- Firebase client (frontend; used for Google Sign-In popup) ----
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ---- Google Gemini (AI biography, companion, image description, video) ----
# Key from https://aistudio.google.com/apikey — format AIza…
GEMINI_API_KEY=""
# Optional: override the API base (default https://generativelanguage.googleapis.com)
# GEMINI_BASE_URL=""

# ---- Email delivery (optional; server-level, configured by the operator) ----
# Protocol: "SMTP" or "Resend". With nothing configured, a disposable Ethereal
# test account is used and messages are NOT really delivered.
EMAIL_PROTOCOL="SMTP"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"LifeBook" <no-reply@lifebook.com>'
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"

# ---- App ----
# Public URL, used in outbound legacy-message emails.
APP_URL="http://localhost:3000"

# AI Companion: messages each user may send per calendar month (default 2; -1 = unlimited)
# COMPANION_MONTHLY_LIMIT=2

# Razorpay (real ₹ payments for storage plans — dashboard → Settings → API Keys, Test Mode first)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx  (webhooks → /api/subscription/webhook)
