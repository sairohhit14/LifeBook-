{
  "name": "lifebook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:frontend": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'db.json'].forEach(p => fs.rmSync(p, {recursive: true, force: true}))\"",
